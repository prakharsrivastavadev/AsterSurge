# ======================================
# AsterSurge Environment Configuration
# ======================================

# Framework
ASTERSURGE_PROVIDER=groq
ASTERSURGE_MODEL=llama-3.3-70b-versatile

ASTERSURGE_TEMPERATURE=0.2
ASTERSURGE_MAX_TOKENS=1024
ASTERSURGE_TIMEOUT=120

ASTERSURGE_DEBUG=false
ASTERSURGE_LOG_LEVEL=INFO

# ======================================
# API Keys
# ======================================

GROQ_API_KEY=

OPENAI_API_KEY=

GEMINI_API_KEY=

# ======================================
# Ollama
# ======================================

OLLAMA_HOST=http://localhost:11434

# ======================================
# API Server
# ======================================

API_HOST=127.0.0.1
API_PORT=8000

# ======================================
# Storage
# ======================================

MEMORY_PATH=memory.json

CACHE_ENABLED=true

PLUGINS_ENABLED=true
